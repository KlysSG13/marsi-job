# Telegram Bot Token (получить у @BotFather)
MARSIJOB_TOKEN=your_bot_token_here

# LLM API (Zhipu GLM, https://open.bigmodel.cn)
MARSIJOB_LLM_KEY=your_api_key_here
MARSIJOB_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MARSIJOB_LLM_MODEL=glm-4.6

# Database
MARSIJOB_DB=marsijob.db

# Web server (payment webhooks)
MARSIJOB_WEB_HOST=127.0.0.1
MARSIJOB_WEB_PORT=8080

# Admin (ваш Telegram ID — узнать у @userinfobot)
MARSIJOB_ADMIN_TG=your_telegram_id

# Public URL (для ссылок на юридические документы)
MARSIJOB_PUBLIC_URL=https://your-domain.ru

# Robokassa (заполнить после регистрации на robokassa.com)
# ROBOKASSA_LOGIN=your_merchant_login
# ROBOKASSA_PASSWORD_1=your_password_1
# ROBOKASSA_PASSWORD_2=your_password_2
# ROBOKASSA_IS_TEST=1

# hh.ru API (заполнить после регистрации на dev.hh.ru)
# HH_CLIENT_ID=your_client_id
# HH_CLIENT_SECRET=your_client_secret

# Sync interval
MARSIJOB_SYNC_ENABLED=1
MARSIJOB_SYNC_HOURS=4
